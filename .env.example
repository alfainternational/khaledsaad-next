APP_NAME="أثر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

PLATFORM_ID=khaledsaad-next
PLATFORM_NAME="أثر"
PLATFORM_TAGLINE="تعلّم. طبّق. قِس الأثر."
PLATFORM_PUBLIC_HOST=next.khaledsaad.net
PLATFORM_PRIMARY_HOST=khaledsaad.net
PLATFORM_LOCALE=ar
PLATFORM_SUPPORT_EMAIL=hello@khaledsaad.net
PLATFORM_BACKUP_MARKER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYMENT_PRO_AMOUNT=1300
PAYMENT_PRO_CURRENCY=USD
PAYMENT_PRO_CREDITS=100

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- سلسلة مزوّدي الذكاء الاصطناعي (config/ai.php) --------------------------
# الترتيب: أول مزوّد مهيأ وغير مستنفد يُستعمل. الطبقات المجانية تُكدَّس فتصير خدمة واحدة موثوقة.
AI_CHAIN=gemini,cloudflare,groq,openai
# المزوّد الذي تُوجَّه إليه البيانات الحساسة؛ يجب أن يكون trains_on_input=false
AI_SENSITIVE_PROVIDER=cloudflare
AI_MAX_OUTPUT_TOKENS=4000
# حصة كل مساحة عمل شهرياً: الندرة على مكدس مجاني هي الطلبات والتوكنز لا الدولار
AI_WORKSPACE_MONTHLY_REQUESTS=400
AI_WORKSPACE_MONTHLY_TOKENS=2000000
# 0 = بلا كاش (الافتراضي). ارفعها لتقليل الاستهلاك حيث تُقبل إعادة نفس الجواب.
AI_CACHE_TTL_MINUTES=0

# Google AI Studio — الطبقة المجانية الأسخى. تنبيه: طبقتها المجانية قد تستخدم مدخلاتك لتحسين الخدمة.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRAINS_ON_INPUT=true
GEMINI_RPM=10
GEMINI_RPD=200

# Cloudflare Workers AI — مخصّص يومي مجاني، ولا يتدرّب على المدخلات.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Groq — طبقة مجانية سريعة بصيغة OpenAI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# لوحة السوق المحاكى — سقف التشغيل الواحد (البند 3). الأرقام هنا هي الحد، لا التعليمات النصية.
AI_PANEL_MAX_VOICES=5
AI_PANEL_MAX_ROUNDS=2
AI_PANEL_MAX_OUTPUT_TOKENS=600
# إعادة إنتاج السجل: نفس المدخلات تعيد نفس اللوحة خلال هذه المدة بلا استهلاك حصة.
AI_PANEL_CACHE_TTL_MINUTES=1440

# Cloudflare R2 — التخزين المنفصل للأصول المولّدة (البند 2). اتركها فارغة فيسقط القرص إلى مجلد محلي.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_DEFAULT_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true
# نطاق التسليم العام للأصول المشتركة؛ فارغ = روابط موقّعة قصيرة العمر فقط.
R2_PUBLIC_URL=

# استوديو الأصول البصرية (البند 4). الحد على البكسلات هو ما يمنع قنبلة فك الضغط، لا الحجم وحده.
STUDIO_MAX_BYTES=8388608
STUDIO_MAX_MEGAPIXELS=12
STUDIO_MAX_TEMPLATES=6
STUDIO_JPEG_QUALITY=88
# خط عربي مثبّت على الخادم؛ بدونه تُعطَّل كتابة العنوان على الصورة ويبقى القصّ والشعار.
STUDIO_FONT_PATH=

# قاعدة جلب الويب (الموجة 0، البند 3). الحارس يرفض العناوين الداخلية دائماً ولا يُعطَّل بمتغير بيئة.
WEB_FETCH_USER_AGENT="AtharBot/1.0 (+https://next.khaledsaad.net/about)"
WEB_FETCH_TIMEOUT=12
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_RPM_PER_HOST=10
WEB_FETCH_RPD_PER_HOST=300
WEB_FETCH_CACHE_MINUTES=360
# Jina Reader يحوّل الصفحة إلى Markdown نظيف؛ يعمل بلا مفتاح بسقف أقل، والمفتاح يرفع السقف فقط.
WEB_FETCH_READER_ENABLED=true
JINA_API_KEY=
