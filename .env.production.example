# =============================================================================
# أثر — قالب بيئة الإنتاج لـ next.khaledsaad.net
# انسخه إلى .env على الخادم (لا يُرفع إلى git) واملأ كل قيمة معلّمة بـ <...>.
# بعد التعبئة: php artisan key:generate --force  ثم  php artisan platform:doctor --env=production
# كل مفتاح أدناه مطلوب لنجاح platform:doctor ما لم يُذكر أنه اختياري.
# =============================================================================

# ---- التطبيق ----------------------------------------------------------------
APP_NAME="أثر"
APP_ENV=production
APP_KEY=                                   # يُولَّد بـ key:generate --force
APP_DEBUG=false
APP_URL=https://next.khaledsaad.net        # يجب أن يبدأ بـ https://
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

# ---- هوية المنصة ------------------------------------------------------------
PLATFORM_ID=khaledsaad-next
PLATFORM_NAME="أثر"
PLATFORM_TAGLINE="تعلّم. طبّق. قِس الأثر."
PLATFORM_PUBLIC_HOST=next.khaledsaad.net
PLATFORM_PRIMARY_HOST=khaledsaad.net
PLATFORM_LOCALE=ar
PLATFORM_SUPPORT_EMAIL=hello@khaledsaad.net
# ملف يلمسه سكربت النسخ الاحتياطي بعد كل نسخة ناجحة؛ الفحص يفشل إن مرّ عليه أكثر من 24 ساعة
PLATFORM_BACKUP_MARKER=/var/backups/khaledsaad-next/last-success

# ---- السجلات ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---- قاعدة البيانات (PostgreSQL حسب دليل النشر؛ بديل MySQL بالأسفل) ---------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=khaledsaad_next
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>
# بديل MySQL 8:
# DB_CONNECTION=mysql
# DB_PORT=3306

# قاعدة الموقع القديم (للقراءة فقط أثناء استيراد المحتوى قبل الانتقال). المستخدم وكلمة المرور تُؤخذ من DB_* ما لم تُحدَّد.
LEGACY_DB_DATABASE=kcepljda_my
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=

# ---- الجلسات والكاش والطوابير (كلها على Redis حتى تعمل فحوصات heartbeat) ----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=next.khaledsaad.net
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=khaledsaad_next
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---- البريد (مزوّد حقيقي؛ log/array يُفشلان الفحص) ----------------------------
# المعتمد حالياً على cPanel: MAIL_MAILER=sendmail (مرسل الخادم المحلي بلا مصادقة، يحمل DKIM للنطاق).
# بديل SMTP بحساب بريد: MAIL_MAILER=smtp مع MAIL_SCHEME=smtps للمنفذ 465 أو smtp للمنفذ 587 (لا يُستخدم MAIL_ENCRYPTION في هذا الإصدار).
MAIL_MAILER=sendmail
MAIL_SCHEME=tls
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=hello@khaledsaad.net
MAIL_FROM_NAME="${APP_NAME}"
# بديل: MAIL_MAILER=postmark مع POSTMARK_API_KEY=  أو  MAIL_MAILER=resend مع RESEND_API_KEY=

# ---- التخزين (S3 أو متوافق معه: R2 / DigitalOcean Spaces / MinIO) -------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<storage-access-key>
AWS_SECRET_ACCESS_KEY=<storage-secret-key>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=khaledsaad-next
AWS_ENDPOINT=<https://storage-endpoint>      # اتركه فارغاً مع AWS S3 الأصلي
AWS_USE_PATH_STYLE_ENDPOINT=true           # true لـ R2/MinIO، false لـ AWS S3

# ---- الذكاء الاصطناعي (بوابة الأدوات) ---------------------------------------
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- الدفع: PayPal (Orders v2 + webhook على المسار /webhooks/paypal) -----------
# PayPal لا يحصّل بالريال السعودي، لذلك سعر الخطة بالدولار الأمريكي.
PAYPAL_CLIENT_ID=<live-client-id>          # من developer.paypal.com → Apps & Credentials → Live
PAYPAL_SECRET=<live-secret>
PAYPAL_MODE=live                           # sandbox للاختبار، live للإنتاج (الفحص يشترط live)
PAYPAL_WEBHOOK_ID=<webhook-id>             # معرّف الـ webhook بعد إنشائه على https://next.khaledsaad.net/webhooks/paypal
PAYMENT_PRO_AMOUNT=1300                    # بالسنت: 1300 = 13.00 USD
PAYMENT_PRO_CURRENCY=USD
PAYMENT_PRO_CREDITS=100

# ---- الواجهة ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---- سلسلة مزوّدي الذكاء الاصطناعي (config/ai.php) --------------------------
# الترتيب: أول مزوّد مهيأ وغير مستنفد يُستعمل. الطبقات المجانية تُكدَّس فتصير خدمة واحدة موثوقة.
AI_CHAIN=gemini,cloudflare,groq,openai
# المزوّد الذي تُوجَّه إليه البيانات الحساسة؛ يجب أن يكون trains_on_input=false
AI_SENSITIVE_PROVIDER=cloudflare
AI_MAX_OUTPUT_TOKENS=4000
# حصة كل مساحة عمل شهرياً: الندرة على مكدس مجاني هي الطلبات والتوكنز لا الدولار
AI_WORKSPACE_MONTHLY_REQUESTS=400
AI_WORKSPACE_MONTHLY_TOKENS=2000000
# 0 = بلا كاش (الافتراضي). ارفعها لتقليل الاستهلاك حيث تُقبل إعادة نفس الجواب.
AI_CACHE_TTL_MINUTES=0

# Google AI Studio — الطبقة المجانية الأسخى. تنبيه: طبقتها المجانية قد تستخدم مدخلاتك لتحسين الخدمة.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRAINS_ON_INPUT=true
GEMINI_RPM=10
GEMINI_RPD=200

# Cloudflare Workers AI — مخصّص يومي مجاني، ولا يتدرّب على المدخلات.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Groq — طبقة مجانية سريعة بصيغة OpenAI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# لوحة السوق المحاكى — سقف التشغيل الواحد (البند 3). الأرقام هنا هي الحد، لا التعليمات النصية.
AI_PANEL_MAX_VOICES=5
AI_PANEL_MAX_ROUNDS=2
AI_PANEL_MAX_OUTPUT_TOKENS=600
# إعادة إنتاج السجل: نفس المدخلات تعيد نفس اللوحة خلال هذه المدة بلا استهلاك حصة.
AI_PANEL_CACHE_TTL_MINUTES=1440
